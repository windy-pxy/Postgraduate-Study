# Secrets: never track real environment files
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# Runtime logs and Python caches
*.log
logs/*
!logs/.gitkeep
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/

# Temporary and device-specific files
*.tmp
*.temp
*.swp
*~
~$*
.DS_Store
Thumbs.db
desktop.ini

# API caches
.cache/
api-cache/
api_cache/

# All original materials remain local, including PDF/PPT/Word
/sources-original/**
!/sources-original/**/
!/sources-original/**/.gitkeep
# Large source documents elsewhere also stay local
*.[pP][dD][fF]
*.[pP][pP][tT]
*.[pP][pP][tT][xX]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]

# All Obsidian configuration stays local, at every directory depth.
# Keep these after original-directory exceptions so no .gitkeep is re-included.
**/.obsidian/
**/.obsidian/**

# Claudian per-vault settings, sessions, transcripts, and runtime state stay local.
**/.claudian/
**/.claudian/**

# Phase 2A: synthetic test sandboxes and operation lock stay local.
/tests/.runtime/
/config/.source-manager.lock

# Local source identity and runtime records. Keep examples and directory anchors.
/config/sources-original.baseline.json
!/config/sources-original.baseline.example.json
/config/source-manifests/*
!/config/source-manifests/.gitkeep
/import-inbox/*
!/import-inbox/.gitkeep
/review-queue/import-plans/*
!/review-queue/import-plans/.gitkeep
/review-queue/pdf-parse-blocks/*
!/review-queue/pdf-parse-blocks/.gitkeep
/review-queue/parsing-routing/*
!/review-queue/parsing-routing/.gitkeep
/review-queue/parsing-jobs/*
!/review-queue/parsing-jobs/.gitkeep
/review-queue/parsing-checkpoints/*
!/review-queue/parsing-checkpoints/.gitkeep
/review-queue/enhanced-experiments/*
!/review-queue/enhanced-experiments/.gitkeep
# Page-level review aids and corrected candidates contain parsed content; keep local.
/review-queue/*.md

# WorkBuddy assistant local state stays on this machine.
/.workbuddy-ai/

# Real derived outputs remain local; keep only the system index and root anchor.
/vault/90-Parsed-Sources/*
!/vault/90-Parsed-Sources/.gitkeep
!/vault/90-Parsed-Sources/Parsed-Sources-MOC.md

# Local models and caches never enter Git.
/models/*
!/models/.gitkeep

# Rebuildable local retrieval index stays on this machine.
/indexes/*
!/indexes/.gitkeep
